# ---- Postgres ----
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_DB=nutrition
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
# SQLAlchemy connection string. In Docker the host is the "db" service.
DATABASE_URL=postgresql+psycopg://nutrition:nutrition@db:5432/nutrition

# JWT / auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- USDA FoodData Central API ----
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=DEMO_KEY
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1

# ---- Frontend (Vite) ----
FRONTEND_PORT=5173
